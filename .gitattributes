# New Eden Atlas - line endings and large-file handling
#
# The repository is authored on Windows but the generated data products and
# scripts are LF throughout. Normalizing here keeps a rebuild from producing
# whole-file diffs caused only by line endings.

# Default: detect text, store LF in the repository, check out LF.
* text=auto eol=lf

# Generated data products (text).
*.json   text eol=lf
*.jsonl  text eol=lf
*.csv    text eol=lf

# Source and interface.
*.py     text eol=lf
*.js     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf

# Binary products. Marked explicitly so no end-of-line conversion is ever
# attempted on them. Both are regenerated wholesale by build_offline_map.py.
*.zip    binary
*.sqlite binary
